{
  "name": "nebla-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/keep-dist.mjs && node scripts/check-icons.mjs",
    "preview": "vite preview",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "gen:check": "pnpm gen && git diff --exit-code src/api/schema.d.ts",
    "lint": "eslint .",
    "format": "prettier --write src",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --exclude 'e2e/**'",
    "e2e": "playwright test",
    "e2e:accessibility": "playwright test --config playwright.accessibility.config.ts"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@iconify-json/lucide": "1.2.158",
    "@novnc/novnc": "1.7.0",
    "@nuxt/ui": "4.13.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/vue-query": "5.108.4",
    "@unovis/ts": "1.8.1",
    "@unovis/vue": "1.8.1",
    "@vueuse/core": "15.1.0",
    "d3-shape": "3.2.1",
    "openapi-fetch": "0.17.0",
    "tailwindcss": "4.3.5",
    "uqr": "0.1.3",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "glob": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.9"
    }
  }
}
