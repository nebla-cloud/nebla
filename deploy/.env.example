# Copy to deploy/.env and fill in. Never commit the real .env.
# Compose refuses to start while a required value below is empty.

# Public URL users reach the panel on; also the allowed console websocket origin.
# Passkeys need it on https with a domain name (or http://localhost), and changing its host makes existing passkeys stop working, though passwords still work.
PANEL_BASE_URL=https://panel.example.com

# Required. Seals Proxmox token secrets at rest; generate once and keep it safe:
#   openssl rand -base64 48
# Changing or losing it makes the stored Proxmox token secrets unreadable.
PANEL_SECRET_KEY=

# Required. Password for the bundled Postgres: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional SMTP for invites, e.g. smtp://user:pass@mail.example.com:587
PANEL_SMTP_URL=

# Optional. Comma-separated CIDRs or IPs of reverse proxies in front of the panel, e.g. 172.16.0.0/12,10.0.0.5
# Their X-Forwarded-For is then trusted for rate limits. Leave empty when clients connect directly.
PANEL_TRUSTED_PROXIES=

# Optional. Quota for projects created by non-admin users; keys left out keep their default, 0 means unlimited. Admin-created projects are always unlimited.
# PANEL_DEFAULT_QUOTA=servers=5,vcpu=8,memory_mb=16384,disk_gb=200,ips=5

# Optional. Projects a non-admin user may own; 0 means unlimited. Admins are never capped.
# PANEL_MAX_PROJECTS_PER_USER=3

# Host port the panel is published on.
PANEL_PORT=8080

# Optional. Panel image; defaults to the pinned release in compose.yaml. Set nebla:dev to run a local build.
# NEBLA_IMAGE=ghcr.io/nebla-cloud/nebla:0.2
